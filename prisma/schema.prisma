// Pacific Restroom Cubicle — Prisma Schema
// Database: PostgreSQL via Supabase
// ORM: Prisma v5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth & RBAC ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String
  lastName     String
  role         UserRole @default(EDITOR)
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Existing Relations
  products            Product[]
  projects            CommercialProject[]
  quotations          Quotation[]

  // Extended ERP & RBAC Relations
  userRoles           UserRoleAssignment[]
  entityAccess        UserEntityAccess[]
  auditLogs           AuditLog[]
  createdPOs          PurchaseOrder[]             @relation("POCreatedBy")
  approvedPOs         PurchaseOrder[]             @relation("POApprovedBy")
  createdPIs          ProformaInvoice[]           @relation("PICreatedBy")
  issuedPIs           ProformaInvoice[]           @relation("PIIssuedBy")
  assignedFollowups   PaymentFollowup[]           @relation("FollowupAssignedTo")
  followupLogs        PaymentFollowupLog[]
  poStatusChanges     PurchaseOrderStatusHistory[]
  piStatusChanges     ProformaInvoiceStatusHistory[]
  createdSalesQuotations SalesQuotation[]         @relation("QuotationCreatedBy")
  issuedSalesQuotations  SalesQuotation[]         @relation("QuotationIssuingStaff")
  createdSalesOrders     SalesOrder[]             @relation("OrderCreatedBy")
  approvedSalesOrders    SalesOrder[]             @relation("OrderApprovedBy")
  createdPackingLists    PackingList[]            @relation("PackingListCreatedBy")
  createdHardwareIssues  HardwareIssueList[]      @relation("HardwareIssueCreatedBy")
  orderStatusChanges     SalesOrderStatusHistory[]

  // Export Relations
  exportOrdersCreated      ExportOrder[]           @relation("ExportOrderCreatedBy")
  exportQuotesCreated      ExportQuotation[]       @relation("ExportQuoteCreatedBy")
  exportComplianceReviewed ExportComplianceCheck[] @relation("ComplianceReviewedBy")
  exportDocsUploaded       ExportDocument[]        @relation("ExportDocUploadedBy")
  exportTasksAssigned      ExportTask[]            @relation("ExportTaskAssignedTo")
  exportEmailsSent         ExportEmailLog[]        @relation("ExportEmailSentBy")

  // Security, 2FA & Session Additions
  mustChangePassword      Boolean          @default(false)
  twoFactorEnabled        Boolean          @default(false)
  twoFactorSecret         String?
  twoFactorRecoveryCodes  String[]         @default([])
  isTwoFactorPending      Boolean          @default(false)
  lastLoginAt             DateTime?
  lastLoginIp             String?
  sessions                AdminSession[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  WAREHOUSE_MANAGER
  FINANCE_OFFICER
  PROCUREMENT_MANAGER
  EXPORT_MANAGER
  EDITOR
  VIEWER
}

model AdminSession {
  id           String    @id @default(uuid())
  userId       String
  sessionToken String    @unique @default(uuid())
  refreshToken String?   @unique
  ipAddress    String?
  userAgent    String?
  browser      String?
  os           String?
  deviceType   String?   // "desktop", "mobile", "tablet"
  isActive     Boolean   @default(true)
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedBy    String?   // "USER", "SUPER_ADMIN", "PASSWORD_CHANGE"
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("admin_sessions")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  code        String           @unique // e.g. SUPER_ADMIN, ENTITY_ADMIN, SALES_MANAGER, PROCUREMENT_MANAGER, ACCOUNTANT
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  permissions RolePermission[]
  userRoles   UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. crm:view, po:approve, pi:issue, qr:scan
  module      String           // CRM, Procurement, Sales, Finance, QR, Inventory, Settings
  description String
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserEntityAccess {
  userId           String
  companyProfileId String
  createdAt        DateTime       @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  @@id([userId, companyProfileId])
  @@map("user_entity_access")
}

// ─── Company / Entity Management ─────────────────────────────────────────────

model CompanyProfile {
  id          String   @id @default(uuid())
  companyName String
  legalName   String
  entityCode  String   @unique // e.g. PRC_IN, PRC_UAE
  country     String   @default("India")
  currency    String   @default("INR") // INR, AED, USD
  taxRegime   String   @default("GST") // GST, VAT
  gstin       String?
  pan         String?
  vatNumber   String?
  state       String?
  stateCode   String?  // e.g. 07 for Delhi
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  signatureUrl String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addresses       CompanyAddress[]
  bankAccounts    CompanyBankAccount[]
  terms           CompanyTerm[]
  signatories     CompanySignatory[]
  sequences       DocumentSequence[]
  parties         BusinessParty[]
  purchaseOrders   PurchaseOrder[]
  proformaInvoices ProformaInvoice[]
  salesQuotations  SalesQuotation[]
  salesOrders      SalesOrder[]
  packingLists     PackingList[]
  payments         Payment[]
  userAccess       UserEntityAccess[]
  exportQuotations ExportQuotation[]
  exportOrders     ExportOrder[]

  @@map("company_profiles")
}

model CompanyAddress {
  id               String         @id @default(uuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  type             String         @default("REGISTERED") // REGISTERED, BILLING, FACTORY, WAREHOUSE, DELIVERY
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  stateCode        String?
  postalCode       String
  phone            String?
  gstin            String?
  pan              String?
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@map("company_addresses")
}

model CompanyBankAccount {
  id               String         @id @default(uuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  bankName         String
  accountNumber    String
  ifscCode         String?
  swiftCode        String?
  branch           String?
  iban             String?
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@map("company_bank_accounts")
}

model CompanyTerm {
  id               String         @id @default(uuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  documentType     String         // PO, PI, INVOICE, QUOTATION
  title            String
  content          String
  sortOrder        Int            @default(0)
  isDefault        Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@map("company_terms")
}

model CompanySignatory {
  id               String         @id @default(uuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  name             String
  designation      String
  signatureUrl     String?
  isDefault        Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@map("company_signatories")
}

model DocumentSequence {
  id               String         @id @default(uuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  documentType     String         // PO, PI, SO, INV
  fiscalYear       String         // e.g. "2026-27"
  prefix           String         // e.g. "PRC/FY2026-27/", "PPS/PI/2026-27/"
  currentNumber    Int            @default(0)
  padding          Int            @default(6)
  updatedAt        DateTime       @updatedAt

  @@unique([companyProfileId, documentType, fiscalYear])
  @@map("document_sequences")
}

// ─── Business Parties (CRM & Procurement Master) ─────────────────────────────

model BusinessParty {
  id               String          @id @default(uuid())
  companyProfileId String?
  companyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id])
  partyType        PartyType       @default(CUSTOMER)
  legalName        String
  tradeName        String?
  gstin            String?
  pan              String?
  email            String?
  phone            String?
  status           String          @default("ACTIVE")
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customerProfile  CustomerProfile?
  vendorProfile    VendorProfile?
  contacts         PartyContact[]
  addresses        PartyAddress[]
  purchaseOrders   PurchaseOrder[]
  proformaInvoices ProformaInvoice[]
  salesQuotations  SalesQuotation[]
  salesOrders      SalesOrder[]
  packingLists     PackingList[]
  hardwareIssues   HardwareIssueList[]
  payments         Payment[]
  followups        PaymentFollowup[]
  dispatchRecords  DispatchRecord[]

  // Export Relations
  exportCustomerProfile  ExportCustomerProfile?
  exportBankAccounts     ExportCustomerBankAccount[]
  exportRfqs             ExportRfq[]
  exportQuotations       ExportQuotation[]
  exportOrders           ExportOrder[]
  forwarderShipments     ExportShipment[]        @relation("ForwarderShipments")
  chaCustomsRecords      ExportCustomsRecord[]   @relation("ChaCustomsRecords")
  exportComplianceChecks ExportComplianceCheck[]
  exportExpenses         ExportExpense[]         @relation("VendorExportExpenses")
  exportEmails           ExportEmailLog[]

  @@index([legalName])
  @@index([gstin])
  @@index([email])
  @@index([phone])
  @@map("business_parties")
}

enum PartyType {
  CUSTOMER
  VENDOR
  BOTH
}

model CustomerProfile {
  id               String        @id @default(uuid())
  partyId          String        @unique
  party            BusinessParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  customerType     String        @default("CONTRACTOR") // CONTRACTOR, ARCHITECT, CORPORATE, INSTITUTIONAL
  creditLimit      Decimal?      @db.Decimal(12, 2)
  paymentTermsDays Int           @default(30)
  status           String        @default("ACTIVE")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  receivableEntries ReceivableEntry[]

  @@map("customer_profiles")
}

model VendorProfile {
  id               String        @id @default(uuid())
  partyId          String        @unique
  party            BusinessParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  vendorType       String        @default("RAW_MATERIALS") // HPL_BOARDS, HARDWARE, ALUMINIUM, SS, NYLON, RAW_MATERIALS, FINISHED_GOODS
  paymentTermsDays Int           @default(30)
  status           String        @default("ACTIVE")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payableEntries   PayableEntry[]
  boardItems       BoardInventoryItem[]

  @@map("vendor_profiles")
}

model PartyContact {
  id          String        @id @default(uuid())
  partyId     String
  party       BusinessParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  department  String?
  phone       String?
  email       String?
  isPrimary   Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@map("party_contacts")
}

model PartyAddress {
  id                String        @id @default(uuid())
  partyId           String
  party             BusinessParty @relation(fields: [partyId], references: [id], onDelete: Cascade)
  addressType       String        @default("BILLING") // BILLING, SHIPPING, SITE
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  stateCode         String?       // e.g. "07"
  country           String        @default("India")
  postalCode        String?
  gstin             String?
  isDefaultBilling  Boolean       @default(false)
  isDefaultShipping Boolean       @default(false)
  createdAt         DateTime      @default(now())

  @@map("party_addresses")
}

// ─── Products Master Extended ────────────────────────────────────────────────

model ProductCategory {
  id          String               @id @default(uuid())
  name        String               @unique
  slug        String               @unique
  description String?
  imageUrl    String?
  sortOrder   Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  products      Product[]
  subcategories ProductSubcategory[]

  @@map("product_categories")
}

model ProductSubcategory {
  id          String          @id @default(uuid())
  categoryId  String
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  products    Product[]

  @@unique([categoryId, slug])
  @@map("product_subcategories")
}

model ProductMaterial {
  id        String    @id @default(uuid())
  name      String    @unique // HPL / Compact Laminate, SS 304, Nylon Polyamide, Aluminium Grade 6063
  code      String?
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("product_materials")
}

model ProductFinish {
  id        String    @id @default(uuid())
  name      String    @unique // Suede, Matt, Brushed SS, Black Matte, Powder Coated
  code      String?
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("product_finishes")
}

model ProductUnit {
  id        String    @id @default(uuid())
  code      String    @unique // SET, NOS, SQFT, SQM, KGS, RMT
  name      String
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("product_units")
}

model Product {
  id              String              @id @default(uuid())
  name            String              @default("")
  slug            String              @unique
  description     String?
  shortDesc       String?
  sku             String?             @unique
  barcode         String?             @unique
  hsnSac          String?             // e.g. 9403, 8302
  categoryId      String?
  category        ProductCategory?    @relation(fields: [categoryId], references: [id])
  subcategoryId   String?
  subcategory     ProductSubcategory? @relation(fields: [subcategoryId], references: [id])
  materialId      String?
  material        ProductMaterial?    @relation(fields: [materialId], references: [id])
  finishId        String?
  finish          ProductFinish?      @relation(fields: [finishId], references: [id])
  unitId          String?
  unit            ProductUnit?        @relation(fields: [unitId], references: [id])
  thickness       String?             // e.g. 12mm, 18mm
  cuttingSize     String?             // e.g. 600x1200mm, 1800x2100mm
  gstRate         Decimal?            @db.Decimal(5, 2) @default(18.00)
  basePrice       Decimal?            @db.Decimal(12, 2)
  costPrice       Decimal?            @db.Decimal(12, 2)
  isFeatured      Boolean             @default(false)
  isActive        Boolean             @default(true)
  images          Json                @default("[]")
  specifications  Json                @default("{}")
  tags            String[]
  metaTitle       String?
  metaDescription String?
  createdById     String?
  createdBy       User?               @relation(fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  // Relations
  quotationItems      QuotationItem[]
  variants            ProductVariant[]
  documents           ProductDocument[]
  poItems             PurchaseOrderItem[]
  piItems             ProformaInvoiceItem[]
  salesQuotationItems SalesQuotationItem[]
  salesOrderItems     SalesOrderItem[]
  boms                ProductBom[]
  qrCodes             QrCode[]
  exportRfqItems      ExportRfqItem[]
  exportQuotationItems ExportQuotationItem[]

  @@index([sku])
  @@index([barcode])
  @@index([name])
  @@index([categoryId])
  @@map("erp_products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantName String
  sku         String?  @unique
  barcode     String?
  price       Decimal? @db.Decimal(12, 2)
  attributes  Json     @default("{}") // color, size, thickness
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("product_variants")
}

model ProductDocument {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileType    String?  // PDF, DWG, BIM
  createdAt   DateTime @default(now())

  @@map("product_documents")
}

// ─── Purchase Orders (Procurement) ───────────────────────────────────────────

model PurchaseOrder {
  id                  String             @id @default(uuid())
  poNumber            String             @unique // e.g. PRC/FY2026-27/000001
  companyProfileId    String
  companyProfile      CompanyProfile     @relation(fields: [companyProfileId], references: [id])
  vendorId            String
  vendor              BusinessParty      @relation(fields: [vendorId], references: [id])
  poDate              DateTime           @default(now())
  subject             String?
  description         String?
  deliveryAddressJson Json               // Structured address snapshot
  billingAddressJson  Json               // Structured address snapshot
  paymentTerms        String?            // e.g. "50% Advance and 50% before dispatch"
  deliveryTerms       String?            // e.g. "5 days from date of PO"
  subtotal            Decimal            @db.Decimal(12, 2) @default(0)
  gstAmount           Decimal            @db.Decimal(12, 2) @default(0)
  totalAmount         Decimal            @db.Decimal(12, 2) @default(0)
  currency            String             @default("INR")
  status              POStatus           @default(DRAFT)
  createdById         String?
  createdBy           User?              @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedById        String?
  approvedBy          User?              @relation("POApprovedBy", fields: [approvedById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items               PurchaseOrderItem[]
  statusHistory       PurchaseOrderStatusHistory[]
  qrCodes             QrCode[]
  payableEntries      PayableEntry[]

  @@index([poNumber])
  @@index([vendorId])
  @@index([companyProfileId])
  @@index([status])
  @@index([poDate])
  @@map("purchase_orders")
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  poId            String
  purchaseOrder   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  serialNumber    Int
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String
  finish          String?
  thickness       String?
  cuttingSize     String?
  quantity        Decimal       @db.Decimal(10, 2)
  unit            String        @default("NOS")
  rate            Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  gstRate         Decimal       @db.Decimal(5, 2) @default(18.00)
  gstAmount       Decimal       @db.Decimal(12, 2) @default(0)

  @@map("purchase_order_items")
}

model PurchaseOrderStatusHistory {
  id              String        @id @default(uuid())
  poId            String
  purchaseOrder   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  fromStatus      POStatus?
  toStatus        POStatus
  changedById     String?
  changedBy       User?         @relation(fields: [changedById], references: [id])
  reason          String?
  createdAt       DateTime      @default(now())

  @@map("purchase_order_status_history")
}

// ─── Proforma Invoices (Sales) ───────────────────────────────────────────────

model ProformaInvoice {
  id                      String            @id @default(uuid())
  piNumber                String            @unique // e.g. PPS/PI/2026-27/0815
  piDate                  DateTime          @default(now())
  companyProfileId        String
  companyProfile          CompanyProfile    @relation(fields: [companyProfileId], references: [id])
  customerId              String
  customer                BusinessParty     @relation(fields: [customerId], references: [id])
  placeOfSupply           String            // e.g. "Delhi"
  placeOfSupplyStateCode  String            // e.g. "07"
  reverseCharge           Boolean           @default(false)
  modeOfTransport         String?
  vehicleNumber           String?
  grLrNumber              String?
  linkedPoNumber          String?
  linkedPoDate            DateTime?
  subtotal                Decimal           @db.Decimal(12, 2) @default(0)
  freightAmount           Decimal           @db.Decimal(12, 2) @default(0)
  taxableAmount           Decimal           @db.Decimal(12, 2) @default(0)
  cgstAmount              Decimal           @db.Decimal(12, 2) @default(0)
  sgstAmount              Decimal           @db.Decimal(12, 2) @default(0)
  igstAmount              Decimal           @db.Decimal(12, 2) @default(0)
  totalTaxAmount          Decimal           @db.Decimal(12, 2) @default(0)
  roundingAdjustment      Decimal           @db.Decimal(6, 2)  @default(0)
  grandTotal              Decimal           @db.Decimal(12, 2) @default(0)
  amountInWords           String?
  currency                String            @default("INR")
  status                  PIStatus          @default(DRAFT)
  createdById             String?
  createdBy               User?             @relation("PICreatedBy", fields: [createdById], references: [id])
  issuedById              String?
  issuedBy                User?             @relation("PIIssuedBy", fields: [issuedById], references: [id])
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  orderId                 String?
  order                   SalesOrder?                 @relation(fields: [orderId], references: [id])
  quotationId             String?
  quotationRef            String?
  advancePercentage       Decimal           @db.Decimal(5, 2)  @default(50.00)
  advanceRequiredAmount   Decimal           @db.Decimal(12, 2) @default(0)
  advanceReceivedAmount   Decimal           @db.Decimal(12, 2) @default(0)
  advancePaymentStatus    String            @default("PENDING")
  advancePaymentDate      DateTime?
  advancePaymentReference String?
  advancePaymentMode      String?
  convertedOrderId        String?
  parties                 ProformaInvoiceParty[]
  items                   ProformaInvoiceItem[]
  taxSummary              ProformaInvoiceTaxSummary[]
  terms                   ProformaInvoiceTerm[]
  statusHistory           ProformaInvoiceStatusHistory[]
  qrCodes                 QrCode[]
  verificationTokens      DocumentVerificationToken[]
  paymentAllocations      PaymentAllocation[]
  receivableEntries       ReceivableEntry[]
  followups               PaymentFollowup[]
  packingLists            PackingList[]
  hardwareIssues          HardwareIssueList[]

  @@index([piNumber])
  @@index([orderId])
  @@index([customerId])
  @@index([companyProfileId])
  @@index([status])
  @@index([piDate])
  @@map("proforma_invoices")
}

enum PIStatus {
  DRAFT
  ISSUED
  CONVERTED
  CANCELLED
}

model ProformaInvoiceParty {
  id              String          @id @default(uuid())
  piId            String
  proformaInvoice ProformaInvoice @relation(fields: [piId], references: [id], onDelete: Cascade)
  partyRole       String          // BILL_TO, SHIP_TO
  partyName       String
  gstin           String?
  addressLine     String
  state           String
  stateCode       String?
  phone           String?
  email           String?

  @@map("proforma_invoice_parties")
}

model ProformaInvoiceItem {
  id              String          @id @default(uuid())
  piId            String
  proformaInvoice ProformaInvoice @relation(fields: [piId], references: [id], onDelete: Cascade)
  serialNumber    Int
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id])
  description     String
  hsnSac          String?
  quantity        Decimal         @db.Decimal(10, 2)
  unit            String          @default("NOS")
  rate            Decimal         @db.Decimal(12, 2)
  amount          Decimal         @db.Decimal(12, 2)
  gstRate         Decimal         @db.Decimal(5, 2) @default(18.00)
  taxableAmount   Decimal         @db.Decimal(12, 2)
  cgst            Decimal         @db.Decimal(12, 2) @default(0)
  sgst            Decimal         @db.Decimal(12, 2) @default(0)
