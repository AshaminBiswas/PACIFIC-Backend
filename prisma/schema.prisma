// ─── QR Code Subsystem ───────────────────────────────────────────────────────

model QrCode {
  id                String           @id @default(uuid())
  entityType        String           // PI, PO, PRODUCT, INVENTORY
  entityId          String
  token             String           @unique // Cryptographically secure token
  qrData            String           // e.g. "https://domain.com/verify/pi/{token}"
  qrImageUrl        String?          // Data URL or storage URL
  status            String           @default("ACTIVE") // ACTIVE, REVOKED
  expiresAt         DateTime?
  createdAt         DateTime         @default(now())

  // Optional entity relations
  proformaInvoiceId String?
  proformaInvoice   ProformaInvoice? @relation(fields: [proformaInvoiceId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  productId         String?
  product           Product?         @relation(fields: [productId], references: [id])

  scanLogs          QrScanLog[]
  exportContainers  ExportContainer[]

  @@index([token])
  @@index([entityType, entityId])
  @@map("qr_codes")
}

model DocumentVerificationToken {
  id                     String          @id @default(uuid())
  token                  String          @unique
  documentType           String          // PI, PO
  documentId             String
  proformaInvoiceId      String?
  proformaInvoice        ProformaInvoice? @relation(fields: [proformaInvoiceId], references: [id])
  verificationPayloadJson Json           // Public-safe snapshot
  isValid                Boolean         @default(true)
  createdAt              DateTime        @default(now())

  @@index([token])
  @@map("document_verification_tokens")
}

model QrScanLog {
  id              String    @id @default(uuid())
  qrCodeId        String?
  qrCode          QrCode?   @relation(fields: [qrCodeId], references: [id])
  token           String
  scannedByUserId String?
  ipAddress       String?
  userAgent       String?
  scannedAt       DateTime  @default(now())

  @@map("qr_scan_logs")
}

// ─── Audit System ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
