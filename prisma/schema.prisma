model PaymentFollowup {
  id                   String           @id @default(uuid())
  customerId           String
  customer             BusinessParty    @relation(fields: [customerId], references: [id])
  proformaInvoiceId    String?
  proformaInvoice      ProformaInvoice? @relation(fields: [proformaInvoiceId], references: [id])
  outstandingAmount    Decimal          @db.Decimal(12, 2)
  dueDate              DateTime?
  followupStatus       FollowupStatus   @default(PENDING)
  priority             FollowupPriority @default(MEDIUM)
  assignedUserId       String?
  assignedUser         User?            @relation("FollowupAssignedTo", fields: [assignedUserId], references: [id])
  nextFollowupDate     DateTime?
  promisedPaymentDate  DateTime?
  promisedAmount       Decimal?         @db.Decimal(12, 2)
  notes                String?
