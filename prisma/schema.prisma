  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  logs                 PaymentFollowupLog[]
  reminders            PaymentFollowupReminder[]

  @@index([customerId])
  @@index([dueDate])
  @@index([nextFollowupDate])
  @@index([followupStatus])
  @@index([assignedUserId])
  @@map("payment_followups")
}

enum FollowupStatus {
  PENDING
  CONTACTED
  PROMISED_TO_PAY
  DISPUTED
  RESOLVED
}

enum FollowupPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
