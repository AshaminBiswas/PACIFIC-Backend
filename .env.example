# ==============================================================================
# PACIFIC RESTROOM CUBICLE — BACKEND & CRM ENVIRONMENT CONFIGURATION TEMPLATE
# Enterprise ERP / CRM API Platform (Port 5001)
# Copy this file to .env and configure with your credentials:
#   cp .env.example .env
# ==============================================================================

# ─── 1. Server & Runtime ──────────────────────────────────────────────────────
PORT=5001
NODE_ENV="development"
API_PREFIX="/api/v1"
INSTANCE_ID="pacific-api-1"

# ─── 2. Database Configuration (Supabase PostgreSQL / Prisma) ─────────────────
# Connection pooled URL (Port 6543) for runtime queries & transaction pooler
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=15&pool_timeout=20"

# Direct session connection (Port 5432) for schema migrations & DDL
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── 3. Supabase Cloud Infrastructure (Auth & Storage) ────────────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET_DOCS="documents"
SUPABASE_STORAGE_BUCKET_PRODUCTS="products"

# ─── 4. Authentication & Security (JWT) ───────────────────────────────────────
JWT_SECRET="pacific-enterprise-jwt-access-secret-key-2026-min-32-chars-long"
JWT_REFRESH_SECRET="pacific-enterprise-jwt-refresh-secret-key-2026-min-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── 5. CORS & Allowed Origins ────────────────────────────────────────────────
ADMIN_URL="http://localhost:5176"
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:3000,https://pacific-admin-one.vercel.app,https://admin-delta-kohl.vercel.app"

# ─── 6. Meta WhatsApp Business Cloud API (WhatsApp CRM Core) ───────────────────
# In the original WACRM architecture, your WhatsApp Phone Number ID, Access Token,
# and WABA ID are saved directly into the database via the Pacific Admin UI
# (CRM > Settings > Meta API tab).
#
# The ONLY environment variable strictly required on the server for Meta is:
# META_APP_SECRET — Used to verify HMAC-SHA256 signatures on inbound webhooks from Meta.
# (Find it in: Meta Developer Portal > Your App > App Settings > Basic > App Secret)
META_APP_SECRET="your_meta_app_secret"

# (Optional) Verify token challenge for Meta webhook registration
# Default: pacific_wacrm_verify_secret
WHATSAPP_VERIFY_TOKEN="pacific_wacrm_verify_secret"

# (Optional Overrides) Only needed if you want to bypass the UI Settings tab
# and inject WhatsApp Cloud credentials directly via environment variables:
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ─── 7. CRM AI Assistant Configuration (Gemini / OpenAI / NVIDIA) ─────────────
# Powers automatic AI reply draft generation, BoQ requirements analysis, and lead suggestions.

# Google Gemini API Key (Recommended for fast structured inference)
GEMINI_API_KEY="your-google-gemini-api-key"

# OpenAI API Key (Optional, for GPT-4o-mini message drafts)
OPENAI_API_KEY="sk-your-openai-api-key"

# NVIDIA NIM AI API Key (Optional)
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"

# Default AI Model (e.g., gpt-4o-mini, gemini-1.5-flash)
AI_ASSISTANT_MODEL="gpt-4o-mini"

# ─── 8. Email Notifications & Omnichannel Follow-ups (Resend / SMTP) ──────────
# Used for instant CRM lead alerts, quotation dispatch, and payment statements.
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="Pacific Products & Solutions <sales@pacificproduct.in>"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="sales@pacificrestroomcubicle.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="Pacific Products & Solutions <sales@pacificrestroomcubicle.com>"
